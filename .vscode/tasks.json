{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Pybricks: jalankan main.py",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["${workspaceFolder}/kirim.py", "${workspaceFolder}/main.py", "--name", "${config:pybricks.hubName}"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Pybricks: jalankan kalibrasi.py",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["${workspaceFolder}/kirim.py", "${workspaceFolder}/kalibrasi.py", "--name", "${config:pybricks.hubName}"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Pybricks: jalankan kalibrasi_dinding.py",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["${workspaceFolder}/kirim.py", "${workspaceFolder}/kalibrasi_dinding.py", "--name", "${config:pybricks.hubName}"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Pybricks: jalankan diagnosa.py",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["${workspaceFolder}/kirim.py", "${workspaceFolder}/diagnosa.py", "--name", "${config:pybricks.hubName}"],
      "group": "build",
      "problemMatcher": []
    }
  ]
}
